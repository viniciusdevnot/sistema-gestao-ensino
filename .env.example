# Copie para .env (no seu PC) e preencha. No Netlify, cadastre as mesmas variáveis em
# Site configuration › Environment variables.

# Supabase › Project Settings › API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# SÓ NO NETLIFY (nunca no .env do navegador nem no GitHub): chave secreta usada pelas funções do servidor
# SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role
